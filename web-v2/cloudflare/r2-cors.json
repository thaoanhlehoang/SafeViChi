{
  "rules": [
    {
      "allowed": {
        "origins": ["*"],
        "methods": ["GET", "HEAD"],
        "headers": ["Cache-Control", "If-None-Match", "If-Modified-Since", "Range", "Accept"]
      },
      "exposeHeaders": ["Content-Length", "ETag", "Accept-Ranges"],
      "maxAgeSeconds": 86400
    }
  ]
}
