# Mẫu cấu hình LLM cho src/v2/labeling (generate.py, prelabel.py).
# Chép file này thành .env rồi điền giá trị. KHÔNG commit .env (đã có trong .gitignore).

# Nhà cung cấp: anthropic | openai | gemini (bắt buộc, không có mặc định)
SAFEVICHI_LLM_PROVIDER=

# Tên model của nhà cung cấp đã chọn (bắt buộc)
SAFEVICHI_LLM_MODEL=

# Tùy chọn: địa chỉ API tương thích OpenAI (OpenRouter, DeepSeek...). Để trống nếu dùng API gốc.
SAFEVICHI_LLM_BASE_URL=

# Khóa API: chỉ cần điền khóa của nhà cung cấp đã chọn.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
