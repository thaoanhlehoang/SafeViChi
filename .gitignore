*.py[cod]
*$py.class
*.egg-info/
.eggs/
venv/
env/
.venv/
.Python
build/
dist/

# ==== Jupyter ====
.ipynb_checkpoints/
*.ipynb_checkpoints

# ==== Dữ liệu (không commit dữ liệu thật) ====
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/variants/*
!data/variants/.gitkeep
data/data_final/*
!data/data_final/manifest_mix.json
data/eval_baseline/**/*.jsonl
# Bước 4: bộ ViHOS đã map span mức từ — dựng lại bằng
# `python -m src.dataset_builder.build_vihos`, chỉ giữ manifest làm bằng chứng
data/data_explain/*
!data/data_explain/manifest.json
*.csv
*.tsv
*.parquet

# ==== Model checkpoints (quá nặng cho git, dùng Git LFS hoặc lưu ngoài nếu cần) ====
models/*
!models/.gitkeep
*.bin
*.pt
*.pth
*.onnx
*.safetensors

# ==== Gói zip build để upload Kaggle (tái tạo được, không commit) ====
*.zip

# ==== Node / web demo ====
node_modules/
demo/dist/
package-lock.json

# ==== Biến môi trường & secrets ====
.env
.env.local
*.key

# ==== IDE / OS ====
.vscode/
.idea/
.DS_Store
Thumbs.db

