*.py[cod]
*$py.class
*.egg-info/
.eggs/
venv/
env/
.venv/
.Python
build/
dist/

# ==== Jupyter ====
.ipynb_checkpoints/
*.ipynb_checkpoints

# ==== Dữ liệu (không commit dữ liệu thật) ====
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/variants/*
!data/variants/.gitkeep
*.csv
*.tsv
